{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-workspace/change-record.schema.json",
  "title": "AI Workspace ChangeRecord (planned API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "module_id",
    "kind",
    "title",
    "summary",
    "status",
    "audience",
    "source_issue_urls",
    "source_pr_url",
    "docs_paths",
    "help_paths",
    "wiki_paths",
    "test_evidence",
    "commit_sha",
    "release",
    "verification",
    "breaking_change",
    "migration_notes",
    "created_at",
    "updated_at",
    "version_bump"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[A-Za-z0-9-]{5,80}$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "kind": {
      "enum": [
        "feature",
        "enhancement",
        "bugfix",
        "performance",
        "security",
        "breaking",
        "docs",
        "dependency",
        "maintenance"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "reported",
        "triaged",
        "planned",
        "implementing",
        "merged",
        "verified",
        "released",
        "reverted",
        "cancelled"
      ]
    },
    "audience": {
      "enum": [
        "user",
        "developer",
        "private"
      ]
    },
    "source_issue_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_pr_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "docs_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "help_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wiki_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "release": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "channel"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "nightly",
            "security",
            "internal"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "tests_passed",
        "merge_verified",
        "release_published"
      ],
      "properties": {
        "tests_passed": {
          "type": "boolean"
        },
        "merge_verified": {
          "type": "boolean"
        },
        "release_published": {
          "type": "boolean"
        }
      }
    },
    "breaking_change": {
      "type": "boolean"
    },
    "migration_notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "version_bump": {
      "enum": [
        "major",
        "minor",
        "patch",
        "none"
      ]
    },
    "affected_option_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_impact": {
      "type": "boolean"
    },
    "data_migration": {
      "type": "boolean"
    }
  }
}
